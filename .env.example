# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser commitado no Git (já está no .gitignore).

# Obrigatória para a geração de respostas funcionar (API da Anthropic)
ANTHROPIC_API_KEY=

# Opcionais — se não definidas, o projeto usa Qdrant local embarcado
# e os valores padrão definidos em backend/app/config.py
INVESTAI_QDRANT_URL=
INVESTAI_QDRANT_API_KEY=
INVESTAI_QDRANT_LOCAL_PATH=data/qdrant_local
INVESTAI_COLLECTION_NAME=cvm_demonstracoes
INVESTAI_TOP_K=5
INVESTAI_LLM_MODEL=claude-sonnet-4-6

# Opcional — se vazio, usa SQLite local (data/investai.db). Pra usar um
# Postgres real: postgresql+psycopg2://usuario:senha@localhost:5432/investai
INVESTAI_DATABASE_URL=
INVESTAI_HISTORY_LIMIT=10

# Reranking (cross-encoder) — true por padrão. Desligue se quiser reduzir
# latência/memória numa máquina mais fraca.
INVESTAI_ENABLE_RERANKING=true

# Token gratuito da brapi.dev (https://brapi.dev) pra cotações em tempo
# real. Sem ele, só PETR4/VALE3/MGLU3/ITUB4 funcionam sem autenticação.
INVESTAI_BRAPI_TOKEN=

# Autenticação JWT — OBRIGATÓRIO trocar antes de qualquer deploy público.
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
INVESTAI_SECRET_KEY=TROQUE_ESTA_CHAVE_ANTES_DE_DEPLOY
INVESTAI_ACCESS_TOKEN_EXPIRE_MINUTES=10080
